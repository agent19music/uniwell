{
  "expo": {
    "name": "UniWell",
    "slug": "uniwell",
    "scheme": "uniwell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/uniwell-icon.png",
    "notification": {},
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/uniwell-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uzski.uniwell",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to the camera to record video notes for your journal.",
        "NSMicrophoneUsageDescription": "This app needs access to the microphone to record audio and video notes for your journal."
      }
    },
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/uniwell-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uzski.uniwell",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.2.20",
            "ndkVersion": "25.1.8937393"
          }
        }
      ],
      "./plugins/loading-indicator-plugin.js",
      "@react-native-google-signin/google-signin",
      "expo-audio",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "577b2274-9c11-4801-af8d-a12055a11673"
      }
    },
    "developmentClient": {
      "silentLaunch": true
    }
  }
}