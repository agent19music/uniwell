{
  "expo": {
    "name": "UniWell",
    "slug": "uniwell",
    "scheme": "uniwell",
    "projectId": "577b2274-9c11-4801-af8d-a12055a11673",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "notification": {
      "vapidPublicKey": "BD69zKRe9xUX979PDalrkmcjceNON3CAi8AHIEIeHkg50hAbGUPjfJEKw3-q9MKoeyoVMQpUYMfyfbOsd9d_rXE"
    },
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.uniwell",
      "minVersion": "15.1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sean.uniwell",
      "permissions": [
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.20",
            "ndkVersion": "25.1.8937393"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "577b2274-9c11-4801-af8d-a12055a11673"
      }
    },
    "developmentClient": {
      "silentLaunch": true
    }
  }
}
