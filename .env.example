# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Configuration
# Get this from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Create a Web application client and copy the Client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional: Google AI/Gemini API Key
EXPO_PUBLIC_GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Expo Project ID (from app.json or EAS dashboard)
EXPO_PUBLIC_PROJECT_ID=577b2274-9c11-4801-af8d-a12055a11673

# Optional: analytics (Segment)
EXPO_PUBLIC_SEGMENT_WRITE_KEY=your-segment-write-key

# Optional: library resources (YouTube / News / Spotify)
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key
EXPO_PUBLIC_NEWS_API_KEY=your-newsapi-key
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
