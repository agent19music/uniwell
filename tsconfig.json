{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {  
    "strict": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "target": "ES2020",
    "moduleResolution": "bundler",
    "types": ["node", "react-native"],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
